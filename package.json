{
  "name": "rnd",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted React Native release console — upload builds, QR test installs, promote to stores.",
  "bin": {
    "rnd": "./packages/cli/dist/bin.js"
  },
  "files": [
    "packages/cli/dist"
  ],
  "scripts": {
    "dev": "npm run dev -w @rnd/web",
    "build": "npm run build -w @rnd/web",
    "build:cli": "npm run build -w @rnd/cli",
    "cli": "npm run start -w @rnd/cli",
    "postinstall": "node ./packages/cli/dist/postinstall.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "license": "Apache-2.0"
}
