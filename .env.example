# Dashboard / API
APP_BASE_URL=http://localhost:3000
DEPLOY_API_TOKEN=change-me-to-a-long-random-string

# Cloudflare R2 (S3-compatible) — artifacts + build metadata (no DB)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rn-deploy
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Default app id shown in the console (override per upload with --app)
DEFAULT_APP_ID=my-app

# Sandbox install file on R2. The banner name is this filename without .apk/.ipa/.aab.
# Freecap.apk → "Freecap을 설치해서 간편하게 테스트해보세요!"
SANDBOX_APP_URL=https://pub-xxxxx.r2.dev/Freecap.apk
